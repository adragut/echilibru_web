# Email Service Configuration for Contact Form
# Cloudflare Workers doesn't support Node.js SMTP (nodemailer)
# Use one of the following HTTP-based email services:

# Option 1: SendGrid (Recommended)
EMAIL_SERVICE=sendgrid
EMAIL_API_KEY=your_sendgrid_api_key_here
SENDER_EMAIL=noreply@echilibru.ro
RECIPIENT_EMAIL=terapie.echilibru@gmail.com

# Option 2: EmailJS
# EMAIL_SERVICE=emailjs
# EMAIL_API_KEY=your_emailjs_api_key_here
# EMAILJS_SERVICE_ID=your_service_id
# EMAILJS_TEMPLATE_ID=your_template_id
# EMAILJS_USER_ID=your_user_id

# Option 3: Generic Webhook
# EMAIL_SERVICE=webhook
# WEBHOOK_URL=https://your-webhook-endpoint.com/send
# EMAIL_API_KEY=optional_bearer_token

# Cloudflare configuration
NODE_ENV=production
