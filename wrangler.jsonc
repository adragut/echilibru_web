{
  "name": "echilibru-web",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": [
    "nodejs_compat",
    "disable_nodejs_process_v2"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  },
  "vars": {
    "NODE_ENV": "production",
    "SENDER_EMAIL": "onboarding@resend.dev",
    "RECIPIENT_EMAIL": "terapie.echilibru@gmail.com"
  },
  "secrets": [
    "RESEND_API_KEY"
  ]
}