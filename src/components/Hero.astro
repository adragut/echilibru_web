---
import { getEntry } from 'astro:content';
import assets from '../content/assets.json';

const hero = await getEntry('hero', 'hero/hero');

// Dynamically highlights keywords with elegant brand colors
const formattedHeadline = hero.data.headline
  .replace('Echilibru', '<span class="text-sand-900 drop-shadow-sm font-semibold">Echilibru</span>')
  .replace('vindecare', '<span style="color: #0092B1;" class="italic font-normal font-serif">vindecare</span>');
---

<section id="hero" class="relative min-h-screen flex items-center pt-24 overflow-hidden bg-gradient-to-b from-cream-100/40 via-cream-50 to-cream-50">
  <!-- Soft organic background blur shapes for rich aesthetics -->
  <div class="absolute top-20 right-[-10%] w-[500px] h-[500px] bg-sand-200/20 rounded-full blur-[120px] pointer-events-none z-0"></div>
  <div class="absolute bottom-[-10%] left-[-10%] w-[600px] h-[600px] bg-forest-200/10 rounded-full blur-[150px] pointer-events-none z-0"></div>

  <div class="mx-auto max-w-7xl px-6 py-24 md:py-32 relative z-10 w-full">
    <div class="flex flex-col lg:flex-row items-center gap-16">
      <div class="lg:w-1/2 reveal">
        <h1 class="font-serif font-bold text-forest-950 mb-6 leading-[1.1] clamp-text" set:html={formattedHeadline}>
        </h1>
        <p class="font-sans font-medium text-slate-600 mb-10 leading-relaxed text-lg sm:text-xl tracking-wide max-w-xl">
          {hero.data.subheadline}
        </p>
        <div class="flex flex-col sm:flex-row gap-5">
          <a
            href="#servicii"
            class="bg-forest-950 text-white px-8 py-4 rounded-full btn-transition text-center font-sans font-semibold tracking-wide text-sm"
          >{hero.data.ctaPrimary}</a>
          <a
            href="#contact"
            class="border-2 border-forest-950 text-forest-950 px-8 py-4 rounded-full btn-transition text-center font-sans font-semibold tracking-wide text-sm hover:bg-forest-950 hover:text-white"
          >{hero.data.ctaSecondary}</a>
        </div>
      </div>
      <div class="lg:w-1/2 reveal" style="transition-delay: 200ms;">
        <div class="relative w-full h-[360px] sm:h-[480px] lg:h-[560px] flex items-start justify-end pr-4 animate-float">
          <!-- Background decorative rotated card -->
          <div class="absolute right-0 top-4 w-[85%] h-[300px] sm:h-[400px] lg:h-[460px] bg-sand-900/10 rounded-[2rem] transform rotate-3 z-0"></div>
          
          <!-- Main background image (pasture landscape) -->
          <img
            src={assets.hero}
            alt={hero.data.imageAlt}
            class="relative w-[85%] h-[300px] sm:h-[400px] lg:h-[460px] rounded-[2rem] shadow-xl object-cover border border-white/50 z-10 hover:scale-[1.01] transition-transform duration-500"
          />

          <!-- Secondary foreground image (petting close-up) -->
          <img
            src={assets.heroSecondary}
            alt="Conexiune cu calul"
            class="absolute bottom-4 left-4 w-[50%] h-[160px] sm:h-[220px] lg:h-[260px] rounded-3xl object-cover shadow-2xl border-8 border-cream-50 z-20 hover:scale-105 hover:rotate-2 transition-all duration-500 cursor-pointer"
          />
        </div>
      </div>
    </div>
  </div>
</section>
