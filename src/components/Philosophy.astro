---
import copy from '../content/copy.json';

interface Props {
  philosophie?: typeof copy.philosophie;
}

const { philosophie = copy.philosophie } = Astro.props;

// SVG paths mapped by icon identifier
const paths = {
  users: {
    path: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2 M22 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75',
    hasExtraCircle: true
  },
  sun: {
    path: 'M12 2v4 M12 18v4 M4.93 4.93l2.83 2.83 M16.24 16.24l2.83 2.83 M2 12h4 M18 12h4 M12 2a10 10 0 1 0 0 20 10 10 0 1 0 0-20z',
    hasExtraCircle: false
  },
  heart: {
    path: 'M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 6.67l-2.06-2.06a5.5 5.5 0 0 0-7.78 7.78l12 12a5.5 5.5 0 0 0 7.78-7.78l-3.16-3.16z',
    hasExtraCircle: false
  }
};
---

<section id="philosophy" class="py-24 bg-cream-50 relative overflow-hidden">
  <!-- Subtle background glow shapes -->
  <div class="absolute top-1/2 left-[-10%] w-[400px] h-[400px] bg-forest-200/5 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="mx-auto max-w-7xl px-6 relative z-10">
    <div class="text-center mb-20 reveal">
      <span class="text-sand-900 font-sans text-xs font-bold tracking-[0.2em] uppercase mb-3 block">{philosophie.sectionTitle}</span>
      <h2 class="font-serif font-bold text-forest-950 mb-6 text-3xl sm:text-4xl lg:text-5xl tracking-tight">
        Filosofia Noastra
      </h2>
      <div class="w-16 h-[2px] bg-sand-900 mx-auto mb-6"></div>
      <p class="font-sans text-slate-600 mb-4 max-w-2xl mx-auto text-lg sm:text-xl leading-relaxed">
        {philosophie.description}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {philosophie.values.map((value, idx) => {
        const iconConfig = paths[value.icon as keyof typeof paths] || paths.heart;
        return (
          <div 
            class="bg-white p-8 rounded-3xl shadow-sm hover-lift reveal group border border-slate-100/50" 
            style={`transition-delay: ${idx * 150}ms`}
          >
            <!-- Styled Icon container with squircle geometry, rotating and color swap on hover -->
            <div class="w-14 h-14 bg-forest-50 text-forest-950 rounded-2xl flex items-center justify-center mb-8 transition-all duration-500 group-hover:bg-forest-950 group-hover:text-white group-hover:rotate-6 shadow-sm">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="transform transition-transform duration-500 group-hover:scale-110"
              >
                <path d={iconConfig.path}></path>
                {iconConfig.hasExtraCircle && (
                  <circle cx="9" cy="7" r="4"></circle>
                )}
              </svg>
            </div>
            <h3 class="text-xl font-heading font-semibold text-forest-950 mb-4 tracking-wide group-hover:text-sand-900 transition-colors duration-300">
              {value.title}
            </h3>
            <p class="text-slate-600 leading-relaxed font-sans text-[15px]">
              {value.description}
            </p>
          </div>
        );
      })}
    </div>
  </div>
</section>
