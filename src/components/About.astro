---
import { getEntry } from 'astro:content';
import assets from '../content/assets.json';
import { getEntry as getNavEntry } from 'astro:content';

const about = await getEntry('about', 'about/about');
const nav = await getNavEntry('navigation', 'navigation/navigation');
---

<section id="despre" class="py-24 bg-white relative overflow-hidden">
  <div class="mx-auto max-w-7xl px-6 relative z-10">
    <div class="text-center mb-20 reveal">
      <span class="text-sand-900 font-sans text-xs font-bold tracking-[0.2em] uppercase mb-3 block">{nav.data.links[0].label}</span>
      <h2 class="font-serif font-bold text-forest-950 mb-6 text-3xl sm:text-4xl lg:text-5xl tracking-tight">
        {about.data.sectionTitle}
      </h2>
      <div class="w-16 h-[2px] bg-sand-900 mx-auto mb-6"></div>
      <p class="font-sans text-slate-600 mb-4 max-w-2xl mx-auto text-lg sm:text-xl leading-relaxed font-medium">
        {about.data.description}
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div class="reveal relative">
        <!-- Floating offset backdrop card -->
        <div class="absolute -inset-3 bg-sand-900/10 rounded-3xl transform -rotate-2"></div>
        <img
          src={assets.about}
          alt={about.data.imageAlt}
          class="relative rounded-3xl shadow-2xl object-cover w-full h-[380px] border border-slate-100/50 hover:scale-[1.02] transition-transform duration-500"
        />
      </div>
      <div class="reveal" style="transition-delay: 200ms;">
        <h3 class="font-serif font-semibold text-forest-950 mb-6 text-2xl sm:text-3xl tracking-tight leading-snug">
          {about.data.passionTitle}
        </h3>
        <p class="font-sans text-slate-600 mb-5 leading-relaxed text-base">
          {about.data.passionText1}
        </p>
        <p class="font-sans text-slate-600 mb-8 leading-relaxed text-base">
          {about.data.passionText2}
        </p>
        <div class="flex flex-wrap gap-3">
          {about.data.badges.map(badge => (
            <span class="bg-forest-50/70 border border-forest-100/80 text-forest-950 px-5 py-2 rounded-full text-xs font-semibold tracking-wide hover:bg-forest-100 hover:border-forest-200 transition-all duration-300 shadow-sm">
              {badge}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
