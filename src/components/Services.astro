---
import copy from '../content/copy.json';

interface Props {
  servicii?: typeof copy.servicii;
}

const { servicii = copy.servicii } = Astro.props;

// High-quality, distinct local images corresponding to each service card index
const serviceImages = [
  // Dezvoltare Personala Asistata de Cai: Person petting a horse, connecting
  '/assets/images/service-dezvoltare.jpg',
  // Hipoterapie: Child/adult on a horse with therapist/assistance
  '/assets/images/service-hipoterapie.jpg',
  // Teambuilding & Grupuri: Group of horses or outdoor team activity in nature
  '/assets/images/service-teambuilding.jpg'
];
---

<section id="servicii" class="py-24 bg-white relative overflow-hidden">
  <div class="mx-auto max-w-7xl px-6 relative z-10">
    <div class="text-center mb-20 reveal">
      <span class="text-sand-900 font-sans text-xs font-bold tracking-[0.2em] uppercase mb-3 block">{copy.navigation.links[1].label}</span>
      <h2 class="font-serif font-bold text-forest-950 mb-6 text-3xl sm:text-4xl lg:text-5xl tracking-wide">
        {servicii.sectionTitle}
      </h2>
      <div class="w-16 h-[2px] bg-sand-900 mx-auto mb-6"></div>
      <p class="font-sans text-slate-600 mb-4 max-w-2xl mx-auto text-lg sm:text-xl leading-relaxed">
        {servicii.description}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {servicii.cards.map((card, idx) => (
        <a
          href="#contact"
          class="bg-cream-50 rounded-3xl overflow-hidden shadow-sm hover-lift transition-all duration-300 flex flex-col h-full reveal group border border-slate-100/30"
          style={`transition-delay: ${idx * 150}ms`}
        >
          <div class="h-60 overflow-hidden relative">
            <div class="absolute inset-0 bg-forest-950/10 z-10 transition-opacity duration-300 group-hover:opacity-0"></div>
            <img
              src={serviceImages[idx] || serviceImages[0]}
              alt={card.imageAlt}
              class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
            />
          </div>
          <div class="p-8 flex flex-col flex-grow">
            <h3 class="font-serif font-semibold text-forest-950 mb-4 text-xl tracking-tight transition-colors duration-300 group-hover:text-sand-900">
              {card.title}
            </h3>
            <p class="font-sans text-slate-600 leading-relaxed text-[15px] flex-grow">
              {card.description}
            </p>
            <div class="mt-6 flex items-center text-sm font-semibold text-forest-950 group-hover:text-sand-900 transition-colors duration-300">
              <span>Cere detalii</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1.5 transform group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
