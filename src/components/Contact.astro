---
import copy from '../content/copy.json';

interface Props {
  contact?: typeof copy.contact;
}

const { contact = copy.contact } = Astro.props;

const socialPaths = {
  facebook: 'M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z',
  instagram: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.263.148 4.971 1.691 5.12 5.12.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.429-2.009 5.12-5.12 5.27-1.265.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.971-1.841-5.12-5.12-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.584.07-4.849.149-3.263 1.91-4.971 5.12-5.12 1.265-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.359 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.361-.2 6.78-2.618 6.98-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.2-4.358-2.618-6.78-6.98-6.98zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44 1.44-.645 1.44-1.44-.645-1.44-1.44-1.44z'
};
---

<section id="contact" class="py-24 bg-white relative overflow-hidden">
  <div class="mx-auto max-w-7xl px-6 relative z-10">
    <div class="text-center mb-20 reveal">
      <span class="text-sand-900 font-sans text-xs font-bold tracking-[0.2em] uppercase mb-3 block">{copy.navigation.links[3].label}</span>
      <h2 class="font-serif font-bold text-forest-950 mb-6 text-3xl sm:text-4xl lg:text-5xl tracking-tight">
        {contact.sectionTitle}
      </h2>
      <div class="w-16 h-[2px] bg-sand-900 mx-auto mb-6"></div>
      <p class="font-sans text-slate-600 mb-4 max-w-2xl mx-auto text-lg sm:text-xl leading-relaxed">
        {contact.description}
      </p>
    </div>

    <div
      class="bg-cream-50 rounded-[2rem] shadow-xl overflow-hidden lg:grid lg:grid-cols-12 reveal border border-slate-100/50"
    >
      <div class="p-8 md:p-12 lg:col-span-7">
        <form class="space-y-6">
          <div class="grid sm:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2.5"
                >{contact.form.nameLabel}</label
              ><input type="text" id="name" name="nume" class="w-full px-4 py-3.5 rounded-xl border border-slate-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 transition-all outline-none bg-white font-sans text-sm text-slate-700" required />
            </div>
            <div>
              <label for="email" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2.5"
                >{contact.form.emailLabel}</label
              ><input type="email" id="email" name="email" class="w-full px-4 py-3.5 rounded-xl border border-slate-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 transition-all outline-none bg-white font-sans text-sm text-slate-700" required />
            </div>
          </div>
          <div>
            <label for="service" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2.5"
              >{contact.form.serviceLabel}</label
            ><select id="service" name="serviciu" class="w-full px-4 py-3.5 rounded-xl border border-slate-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 transition-all outline-none bg-white font-sans text-sm text-slate-600 appearance-none cursor-pointer">
              {contact.form.serviceOptions.map(option => (
                <option>{option}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="message" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2.5"
              >{contact.form.messageLabel}</label
            ><textarea id="message" name="mesaj" rows="4" class="w-full px-4 py-3.5 rounded-xl border border-slate-200 focus:border-forest-400 focus:ring-4 focus:ring-forest-50 transition-all outline-none bg-white font-sans text-sm text-slate-700" required></textarea>
          </div>
          <button
            type="submit"
            class="w-full bg-forest-950 text-white px-6 py-4 rounded-xl btn-transition font-sans font-semibold tracking-wider text-xs uppercase"
          >
            {contact.form.submit}
          </button>
        </form>

        <div class="mt-10 pt-10 border-t border-slate-200/60">
          <h3 class="font-serif font-semibold text-forest-950 mb-6 text-xl tracking-wide">{contact.socialMedia.title}</h3>
          <div class="flex space-x-4">
            {contact.socialMedia.links.map(social => (
              <a href={social.url} target="_blank" rel="noopener noreferrer" class="w-11 h-11 bg-forest-950/10 rounded-full flex items-center justify-center hover:bg-forest-950 hover:text-white transition-all duration-300" aria-label={social.platform}>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="transition-colors duration-300"
                >
                  {social.icon === 'facebook' && (
                    <path d={socialPaths.facebook}></path>
                  )}
                  {social.icon === 'instagram' && (
                    <path d={socialPaths.instagram}></path>
                  )}
                </svg>
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="bg-white p-8 md:p-12 lg:col-span-5 flex flex-col justify-between border-t lg:border-t-0 lg:border-l border-slate-200/50">
        <div>
          <h3 class="font-serif font-semibold text-forest-950 mb-8 text-xl tracking-wide">{contact.info.title}</h3>

          <div class="space-y-7">
            <div class="flex items-start">
              <div class="w-11 h-11 bg-forest-50 text-forest-950 rounded-xl flex items-center justify-center mr-4 flex-shrink-0 border border-forest-100/50">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div>
                <p class="font-sans font-bold text-forest-950 text-xs tracking-wider uppercase mb-1">{contact.info.address.label}</p>
                {contact.info.address.lines.map(line => (
                  <p class={line.includes('·') ? 'text-slate-400 font-sans text-xs mt-1' : 'text-slate-600 font-sans text-[15px]'}>{line}</p>
                ))}
              </div>
            </div>

            <div class="flex items-start">
              <div class="w-11 h-11 bg-forest-50 text-forest-950 rounded-xl flex items-center justify-center mr-4 flex-shrink-0 border border-forest-100/50">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.39 2 2 0 0 1-.55-2L2 12a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2 0 0 0 2 2 0 0 0 2-2V8a2 2 0 0 1 2-2h1a2 2 0 0 1 2 2 0 0 0 2 2z"></path>
                  <path d="M5 12v6"></path>
                </svg>
              </div>
              <div>
                <p class="font-sans font-bold text-forest-950 text-xs tracking-wider uppercase mb-1">{contact.info.phone.label}</p>
                <a href={`tel:${contact.info.phone.value.replace(/\s+/g, '')}`} class="text-slate-600 font-sans text-[15px] hover:text-sand-900 transition-colors">{contact.info.phone.value}</a>
              </div>
            </div>

            <div class="flex items-start">
              <div class="w-11 h-11 bg-forest-50 text-forest-950 rounded-xl flex items-center justify-center mr-4 flex-shrink-0 border border-forest-100/50">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <div>
                <p class="font-sans font-bold text-forest-950 text-xs tracking-wider uppercase mb-1">{contact.info.email.label}</p>
                <a href={`mailto:${contact.info.email.value}`} class="text-slate-600 font-sans text-[15px] hover:text-sand-900 transition-colors">{contact.info.email.value}</a>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-10 rounded-2xl overflow-hidden h-64 bg-slate-50 border border-slate-100 shadow-inner">
          <iframe
            src={contact.mapUrl}
            width="100%"
            height="100%"
            style="border:0; filter: grayscale(0.2) contrast(0.9);"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            title="Locatie Terapie ECHILIBRU"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
