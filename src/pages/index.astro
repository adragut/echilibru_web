---
import copy from '../content/copy.json';

const iconPaths = {
  users: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2 M22 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75',
  sun: 'M12 2v4 M12 18v4 M4.93 4.93l2.83 2.83 M16.24 16.24l2.83 2.83 M2 12h4 M18 12h4 M12 2a10 10 0 1 0 0 20 10 10 0 1 0 0-20z',
  heart: 'M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 6.67l-2.06-2.06a5.5 5.5 0 0 0-7.78 7.78l12 12a5.5 5.5 0 0 0 7.78-7.78l-3.16-3.16z'
};

const socialPaths = {
  facebook: 'M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z',
  instagram: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.263.148 4.971 1.691 5.12 5.12.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.429-2.009 5.12-5.12 5.27-1.265.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.971-1.841-5.12-5.12-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.584.07-4.849.149-3.263 1.91-4.971 5.12-5.12 1.265-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.359 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.361-.2 6.78-2.618 6.98-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.2-4.358-2.618-6.78-6.98-6.98zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44 1.44-.645 1.44-1.44-.645-1.44-1.44-1.44z'
};
---

<!DOCTYPE html>
<html lang="ro" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{copy.seo.title}</title>
    <meta name="description" content={copy.seo.description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      .glass {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(229, 231, 219, 1);
      }
      .hover-lift {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }
      .hover-lift:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
      }
    </style>
  </head>

  <body class="bg-cream-50 text-slate-700 font-sans antialiased leading-relaxed" style="font-size: 17px; line-height: 1.75;">
    <header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 backdrop-blur-md bg-white/70 border-b border-gray-100">
      <nav class="mx-auto max-w-7xl px-6 py-4">
        <div class="flex items-center justify-between">
          <a href="#" class="text-2xl font-bold text-forest-950">{copy.navigation.logo}</a>

          <div class="hidden md:flex items-center space-x-8">
            {copy.navigation.links.map(link => (
              <a href={link.href} class="font-sans text-sm font-medium hover:text-sand-900 transition-colors tracking-wide">{link.label}</a>
            ))}
            <a
              href="#"
              class="bg-forest-950 text-white px-6 py-2 rounded-full hover:bg-forest-900 transition-colors font-sans font-semibold text-sm"
            >{copy.navigation.cta}</a>
          </div>

          <button id="mobile-menu-btn" class="md:hidden">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
        </div>

        <div id="mobile-menu" class="hidden md:hidden mt-4 space-y-4">
          {copy.navigation.links.map(link => (
            <a href={link.href} class="block font-sans text-sm font-medium hover:text-sand-900 transition-colors tracking-wide">{link.label}</a>
          ))}
          <a
            href="#"
            class="block bg-forest-950 text-white px-6 py-2 rounded-full hover:bg-forest-900 transition-colors text-center font-sans font-semibold text-sm"
          >{copy.navigation.cta}</a>
        </div>
      </nav>
    </header>

    <main>
      <section id="hero" class="relative min-h-screen flex items-center pt-20">
        <div class="absolute inset-0 bg-gradient-to-b from-forest-950/20 to-transparent z-0"></div>
        <div class="mx-auto max-w-7xl px-6 py-24 md:py-32 relative z-10">
          <div class="flex flex-col md:flex-row items-center gap-16">
            <div class="md:w-1/2">
              <h1 class="font-serif font-bold text-forest-950 mb-6 leading-tight text-5xl sm:text-6xl lg:text-7xl clamp-text">
                {copy.hero.headline}
              </h1>
              <p class="font-sans font-medium text-slate-600 mb-8 leading-relaxed text-lg sm:text-xl tracking-wide">
                {copy.hero.subheadline}
              </p>
              <div class="flex flex-col sm:flex-row gap-4">
                <a
                  href="#servicii"
                  class="bg-forest-950 text-white px-8 py-3 rounded-full hover:bg-forest-900 transition-colors text-center font-sans font-semibold"
                >{copy.hero.ctaPrimary}</a>
                <a
                  href="#contact"
                  class="border-2 border-forest-950 text-forest-950 px-8 py-3 rounded-full hover:bg-forest-950 hover:text-white transition-colors text-center font-sans font-semibold"
                >{copy.hero.ctaSecondary}</a>
              </div>
            </div>
            <div class="md:w-1/2">
              <div class="relative">
                <div
                  class="absolute -inset-4 bg-sand-900/20 rounded-2xl transform rotate-3"
                ></div>
                <img
                  src="https://images.unsplash.com/photo-1548602185-3c0970776e39?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1000&q=80"
                  alt={copy.hero.imageAlt}
                  class="relative rounded-2xl shadow-2xl object-cover w-full h-96 md:h-[500px]"
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="despre" class="py-24 bg-white">
        <div class="mx-auto max-w-7xl px-6">
          <div class="text-center mb-16">
            <h2 class="font-serif font-bold text-forest-950 mb-4 text-3xl sm:text-4xl lg:text-5xl tracking-tight">
              {copy.about.sectionTitle}
            </h2>
            <p class="font-sans text-slate-600 mb-4 max-w-2xl mx-auto text-lg sm:text-xl leading-relaxed">
              {copy.about.description}
            </p>
          </div>

          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div>
              <img
                src="https://images.unsplash.com/photo-1518133910546-b466b8981c49?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1000&q=80"
                alt={copy.about.imageAlt}
                class="rounded-2xl shadow-xl object-cover w-full h-80"
              />
            </div>
            <div>
              <h3 class="font-serif font-semibold text-forest-950 mb-4 text-2xl sm:text-3xl tracking-tight">
                {copy.about.passionTitle}
              </h3>
              <p class="font-sans text-slate-700 mb-4 leading-relaxed text-lg">
                {copy.about.passionText1}
              </p>
              <p class="font-sans text-slate-700 mb-6 leading-relaxed text-lg">
                {copy.about.passionText2}
              </p>
              <div class="flex flex-wrap gap-4">
                {copy.about.badges.map(badge => (
                  <span class="bg-cream-50 text-forest-950 px-4 py-2 rounded-full text-sm">{badge}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="philosophy" class="py-24 bg-cream-50">
        <div class="mx-auto max-w-7xl px-6">
          <div class="text-center mb-16">
            <h2 class="font-serif font-bold text-forest-950 mb-4 text-3xl sm:text-4xl lg:text-5xl tracking-tight">
              {copy.philosophie.sectionTitle}
            </h2>
            <p class="font-sans text-slate-600 mb-4 max-w-2xl mx-auto text-lg sm:text-xl leading-relaxed">
              {copy.philosophie.description}
            </p>
          </div>

          <div class="grid md:grid-cols-3 gap-8">
            {copy.philosophie.values.map(value => (
              <div class="bg-white p-8 rounded-2xl hover-lift">
                <div class="w-12 h-12 bg-forest-950/10 rounded-full flex items-center justify-center mb-6">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d={value.icon === 'users' ? 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2 M22 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75' : value.icon === 'sun' ? 'M12 2v4 M12 18v4 M4.93 4.93l2.83 2.83 M16.24 16.24l2.83 2.83 M2 12h4 M18 12h4 M12 2a10 10 0 1 0 0 20 10 10 0 1 0 0-20z' : 'M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 6.67l-2.06-2.06a5.5 5.5 0 0 0-7.78 7.78l12 12a5.5 5.5 0 0 0 7.78-7.78l-3.16-3.16z'}"></path>
                    {value.icon === 'users' && (
                      <>
                        <circle cx="9" cy="7" r="4"></circle>
                      </>
                    )}
                  </svg>
                </div>
                <h3 class="text-xl font-heading font-semibold text-forest-950 mb-3 tracking-wide">
                  {value.title}
                </h3>
                <p class="text-gray-600 leading-relaxed">
                  {value.description}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="servicii" class="py-24 bg-white">
        <div class="mx-auto max-w-7xl px-6">
          <div class="text-center mb-16">
            <h2 class="font-serif font-bold text-forest-950 mb-4 text-3xl sm:text-4xl lg:text-5xl tracking-wide tracking-wide">
              {copy.servicii.sectionTitle}
            </h2>
            <p class="font-sans text-slate-600 mb-4 max-w-2xl mx-auto text-lg sm:text-xl leading-relaxed">
              {copy.servicii.description}
            </p>
          </div>

          <div class="grid md:grid-cols-3 gap-8">
            {copy.servicii.cards.map(card => (
              <div
                class="bg-cream-50 rounded-2xl overflow-hidden shadow-md hover-lift transition-all duration-300"
              >
                <div class="h-48 overflow-hidden">
                  <img
                    src="https://images.unsplash.com/photo-1541899460891-233d6373cc2e?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1000&q=80"
                    alt={card.imageAlt}
                    class="w-full h-full object-cover"
                  />
                </div>
                <div class="p-8">
                  <h3 class="font-serif font-semibold text-forest-950 mb-3 text-xl tracking-tight">
                    {card.title}
                  </h3>
                  <p class="font-sans text-slate-600 leading-relaxed">
                    {card.description}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="echipa" class="py-24 bg-cream-50">
        <div class="mx-auto max-w-7xl px-6">
          <div class="text-center mb-16">
<h2 class="font-serif font-bold text-forest-950 mb-4 text-3xl sm:text-4xl lg:text-5xl tracking-tight tracking-wide">
              {copy.echipa.sectionTitle}
            </h2>
            <p class="font-sans text-slate-600 mb-4 max-w-2xl mx-auto leading-relaxed">
              {copy.echipa.description}
            </p>
          </div>

          <div class="grid md:grid-cols-3 gap-8">
            {copy.echipa.members.map(member => (
              <div
                class="bg-white rounded-2xl overflow-hidden shadow-md hover-lift transition-all duration-300"
              >
                <div class="h-80 overflow-hidden">
                  <img
                    src="https://images.unsplash.com/photo-1612681774021-c226eb14a29c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1000&q=80"
                    alt={member.imageAlt}
                    class="w-full h-full object-cover"
                  />
                </div>
                <div class="p-6">
                  <h3 class="font-serif font-semibold text-forest-950 mb-1 text-xl tracking-tight">
                    {member.name}
                  </h3>
                  <p class="text-sand-900 mb-3 font-sans font-medium text-sm tracking-wide uppercase">{member.role}</p>
                  <p class="font-sans text-slate-600 text-sm leading-relaxed">
                    {member.description}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="contact" class="py-24 bg-white">
        <div class="mx-auto max-w-7xl px-6">
          <div class="text-center mb-16">
<h2 class="font-serif font-bold text-forest-950 mb-4 text-3xl sm:text-4xl lg:text-5xl tracking-tight tracking-wide">
              {copy.contact.sectionTitle}
            </h2>
            <p class="font-sans text-slate-600 mb-4 max-w-2xl mx-auto leading-relaxed">
              {copy.contact.description}
            </p>
          </div>

          <div
            class="bg-cream-50 rounded-3xl shadow-xl overflow-hidden lg:grid lg:grid-cols-2"
          >
            <div class="p-8 md:p-12">
              <form class="space-y-6">
                <div>
                  <label for="name" class="block text-sm font-medium text-gray-700 mb-2"
                    >{copy.contact.form.nameLabel}</label
                  ><input type="text" id="name" name="nume" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-forest-950 focus:border-transparent transition-all" required />
                </div>
                <div>
                  <label for="email" class="block text-sm font-medium text-gray-700 mb-2"
                    >{copy.contact.form.emailLabel}</label
                  ><input type="email" id="email" name="email" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-forest-950 focus:border-transparent transition-all" required />
                </div>
                <div>
                  <label for="service" class="block text-sm font-medium text-gray-700 mb-2"
                    >{copy.contact.form.serviceLabel}</label
                  ><select id="service" name="serviciu" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-forest-950 focus:border-transparent transition-all">
                    {copy.contact.form.serviceOptions.map(option => (
                      <option>{option}</option>
                    ))}
                  </select>
                </div>
                <div>
                  <label for="message" class="block text-sm font-medium text-gray-700 mb-2"
                    >{copy.contact.form.messageLabel}</label
                  ><textarea id="message" name="mesaj" rows="4" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-forest-950 focus:border-transparent transition-all" required></textarea>
                </div>
                <button
                  type="submit"
                  class="w-full bg-forest-950 text-white px-6 py-3 rounded-lg hover:bg-forest-900 transition-colors font-medium"
                >
                  {copy.contact.form.submit}
                </button>
              </form>

              <div class="mt-8 pt-8 border-t border-gray-200">
                <h3 class="font-serif font-semibold text-forest-950 mb-6 text-xl tracking-wide">{copy.contact.socialMedia.title}</h3>
                <div class="flex space-x-4">
                  {copy.contact.socialMedia.links.map(social => (
                    <a href={social.url} target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-forest-950/10 rounded-full flex items-center justify-center hover:bg-forest-950/20 transition-colors">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="text-forest-950"
                      >
                        {social.icon === 'facebook' && (
                          <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                        )}
                        {social.icon === 'instagram' && (
                          <path d={socialPaths.instagram}></path>
                        )}
                      </svg>
                    </a>
                  ))}
                </div>
              </div>
            </div>

            <div class="bg-white p-8 md:p-12">
              <h3 class="font-serif font-semibold text-forest-950 mb-6 text-xl tracking-wide">{copy.contact.info.title}</h3>

              <div class="space-y-6">
                <div class="flex items-start">
                  <div class="w-10 h-10 bg-forest-950/10 rounded-full flex items-center justify-center mr-4">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                      <circle cx="12" y="10" r="3"></circle>
                    </svg>
                  </div>
                  <div>
                    <p class="font-medium text-forest-950">{copy.contact.info.address.label}</p>
                    {copy.contact.info.address.lines.map(line => (
                      <p class={line.includes('·') ? 'text-gray-500 text-sm' : 'text-gray-600'}>{line}</p>
                    ))}
                  </div>
                </div>

                <div class="flex items-start">
                  <div class="w-10 h-10 bg-forest-950/10 rounded-full flex items-center justify-center mr-4">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.39 2 2 0 0 1-.55-2L2 12a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2 0 0 0 2 2 0 0 0 2-2V8a2 2 0 0 1 2-2h1a2 2 0 0 1 2 2 0 0 0 2 2z"></path>
                      <path d="M5 12v6"></path>
                    </svg>
                  </div>
                  <div>
                    <p class="font-medium text-forest-950">{copy.contact.info.phone.label}</p>
                    <p class="text-gray-600">{copy.contact.info.phone.value}</p>
                  </div>
                </div>

                <div class="flex items-start">
                  <div class="w-10 h-10 bg-forest-950/10 rounded-full flex items-center justify-center mr-4">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                      <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                  </div>
                  <div>
                    <p class="font-medium text-forest-950">{copy.contact.info.email.label}</p>
                    <p class="text-gray-600">{copy.contact.info.email.value}</p>
                  </div>
                </div>
              </div>

              <div class="mt-8 rounded-lg overflow-hidden h-64 bg-gray-200">
                <iframe
                  src={copy.contact.mapUrl}
                  width="100%"
                  height="100%"
                  style="border:0;"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="strict-origin-when-cross-origin"
                ></iframe>
              </div>
            </div>
          </div>
        </div>
      </section>

      <footer class="bg-forest-950 text-white">
        <div class="mx-auto max-w-7xl px-6 py-12">
          <div
            class="flex flex-col md:flex-row justify-between items-center space-y-6 md:space-y-0"
          >
            <div class="text-center md:text-left">
              <p class="font-serif font-bold text-xl mb-2">{copy.footer.logo}</p>
              <p class="text-cream-200 font-sans text-sm leading-relaxed">
                {copy.footer.tagline}
              </p>
            </div>

            <div class="flex flex-wrap justify-center gap-6">
              {copy.footer.links.map(link => (
                <a href={link.href} class="font-sans text-sm hover:text-sand-400 transition-colors tracking-wide">{link.label}</a>
              ))}
            </div>

            <div class="text-center md:text-right">
              <p class="text-cream-200 font-sans text-sm">{copy.footer.copyright}</p>
              <p class="text-cream-200 font-sans text-sm mt-1">{copy.footer.tagline2}</p>
            </div>
          </div>
        </div>
      </footer>
    </main>

    <script>
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      mobileMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });

      // Inchide meniul la click pe link (pentru dispozitive mobile)
      document.querySelectorAll('#mobile-menu a').forEach((link) => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('hidden');
        });
      });
    </script>
  </body>
</html>